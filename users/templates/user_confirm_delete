{% extends 'documents/base.html' %}
{% with active_page='user_list' %}

{% block title %}Confirmare Ștergere Utilizator{% endblock %}

{% block content %}
<div class="max-w-md mx-auto px-4 py-12">
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs space-y-6">
        <div class="text-center space-y-2">
            <div class="inline-flex items-center justify-center w-12 h-12 bg-red-100 text-red-600 rounded-full mb-2">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </div>
            <h1 class="text-xl font-bold text-slate-900">Ștergere definitivă utilizator</h1>
            <p class="text-sm text-slate-500">
                Sunteți sigur că doriți să ștergeți definitiv contul pentru <span class="font-semibold text-slate-800">{{ target_user.username }}</span>? Această acțiune nu poate fi anulată.
            </p>
        </div>

        {% if messages %}
            {% for message in messages %}
                <div class="p-3 bg-red-50 border border-red-200 text-red-700 text-xs rounded-lg">
                    {{ message }}
                </div>
            {% endfor %}
        {% endif %}

        <form method="post" class="space-y-4">
            {% csrf_token %}
            
            <div class="space-y-1">
                <label for="admin_password" class="block text-xs font-semibold uppercase text-slate-600">
                    Introduceți parola Dvs. de administrator pentru confirmare:
                </label>
                <input type="password" name="admin_password" id="admin_password" required placeholder="Parola contului curent" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-red-500">
            </div>

            <div class="flex items-center justify-end gap-3 pt-2">
                <a href="{% url 'userlist' %}" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-sm font-medium transition">
                    Anulează
                </a>
                <button type="submit" class="px-5 py-2.5 bg-red-600 hover:bg-red-700 text-white rounded-xl text-sm font-medium transition shadow-xs">
                    Confirmă Ștergerea
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
{% endwith %}